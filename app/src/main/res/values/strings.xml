<resources>
    <string name="app_name">Audora</string>

    <!-- Walkthrough -->
    <string name="walkthrough_p1_title">A workspace for your music</string>
    <string name="walkthrough_p1_body">Clean up tags, lyrics, and album art for the music already on your device. Everything stays local — nothing is uploaded unless you ask for it.</string>
    <string name="walkthrough_p2_title">See what needs work</string>
    <string name="walkthrough_p2_body">Status dots flag missing or low-res art, absent lyrics, and incomplete tags. Filters narrow the library down to just the tracks with problems.</string>
    <string name="walkthrough_p3_title">Fix many at once</string>
    <string name="walkthrough_p3_body">Select multiple tracks or whole albums, then fetch lyrics and artwork or edit tags in bulk — no need to go file by file.</string>
    <string name="walkthrough_p4_title">Your files, your call</string>
    <string name="walkthrough_p4_body">Changes are written back to your files only when you confirm. Pick a folder next to grant access — you can change it anytime.</string>
